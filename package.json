{
  "name": "philosophy-monorepo",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "description": "Philosophy App Monorepo — Mobile-first Social App client, backend API, & shared contract.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @philosophy/api test:integration",
    "dev:contract": "pnpm --filter @philosophy/contract dev",
    "dev:api": "pnpm --filter @philosophy/api dev",
    "dev:web": "pnpm --filter @philosophy/web dev",
    "contract:build": "pnpm --filter @philosophy/contract build",
    "db:migrate": "pnpm --filter @philosophy/api db:migrate:run",
    "db:generate": "pnpm --filter @philosophy/api db:generate",
    "genesis": "pnpm --filter @philosophy/api genesis && pnpm --filter @philosophy/api seed",
    "release": "bash scripts/release.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
